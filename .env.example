NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# --- api ---
API_PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- mongo ---
MONGO_URI=mongodb://mongodb:27017/travelvietplaner?replicaSet=rs0
MONGO_DB=travelvietplaner

# --- redis ---
REDIS_URL=redis://redis:6379

# --- elasticsearch ---
ES_NODE=http://elasticsearch:9200

# --- qdrant ---
QDRANT_URL=http://qdrant:6333

# --- uploads ---
# Absolute path on host where uploaded files are stored (outside source repo).
# Dev:  UPLOAD_DIR=./uploads  (relative to cwd, or any local folder)
# Prod: UPLOAD_DIR=/data/uploads  (host path mounted into api + nginx containers)
# Files are served at /file/<userId>/<uuid>.ext via nginx alias (prod) or Express static (dev).
UPLOAD_DIR=./uploads

# --- auth (RS256) generated at boot into ./secrets if absent ---
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public.pem
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# --- rag service ---
RAG_URL=http://rag:8000
RAG_SERVICE_TOKEN=change-me-internal-hmac-secret

# --- external providers (leave blank to run in stub mode) ---
GEMINI_API_KEY=
SERPER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
